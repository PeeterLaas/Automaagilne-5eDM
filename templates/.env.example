# Hermes Dungeon Server — Environment Variables
# Copy this file to .env and fill in your values.

# Required: your LLM API key
# Examples: DEEPSEEK_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY, OPENROUTER_API_KEY
DEEPSEEK_API_KEY=

# Optional: Telegram bot for remote play
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=
# TELEGRAM_HOME_CHANNEL=

# Optional: fallback / auxiliary providers
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# OPENAI_API_KEY=

# Optional: other service keys
# WAVESPEED_API_KEY=
# NVIDIA_API_KEY=
